# Binarios — NO aplicar EOL normalization (Git puede corromperlos con CRLF en Windows)
*.parquet binary
*.xlsx binary
*.xls binary
*.zip binary
*.db binary
*.sqlite binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zst binary
*.feather binary
*.pickle binary
*.pkl binary

# Texto — sí aplicar EOL normalization
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
