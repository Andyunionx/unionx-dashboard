# ============================================================================
# Template de variables de entorno — UnionX-IA
# ============================================================================
# Copiar a .env y completar. NUNCA commitear el .env real (está en
# .gitignore). Los secrets se piden por canal privado a Andrés — NO se
# comparten por mail.
#
# Tres formas de proveer un secret (cualquiera funciona):
#   1. Archivo .env en la raíz del repo (este template, completado)
#   2. Variable de entorno del USUARIO Windows:
#        [Environment]::SetEnvironmentVariable("NOMBRE", "valor", "User")
#   3. Streamlit Cloud: configurarlo en st.secrets de cada app
# ============================================================================


# --- 1. BASE DE DATOS TURSO (libSQL) ---
# CRÍTICO para todas las apps Streamlit. Sin esto, las vistas que
# consumen tablas planif_*, ventas, etc. fallan. La app Planificación
# tiene fallback automático a parquets locales si Turso bloquea reads.
LIBSQL_URL=https://unionx-ventas-andresunionx.aws-us-east-1.turso.io
LIBSQL_AUTH_TOKEN=                  # pedir a Andrés

# --- 2. ODOO (XML-RPC) ---
# Necesario SOLO si vas a correr extracts que escriben/leen Odoo
# (extract_baseline_planificacion.py, cargar_po_comex_odoo.py,
# extract_comex_desde_odoo.py). Para usar las apps Streamlit en modo
# lectura NO se necesita.
ODOO_URL=https://unionxb2b.odoo.com
ODOO_DB=bmya-innovatek-sh-prd-6981800
ODOO_USER=andres@grupoeter.cl       # o tu propio user Odoo
ANDRES_ODOO_PASSWORD=               # pedir a Andrés (o setear como Windows env var)

# --- 3. GOOGLE SERVICE ACCOUNT (Sheets API) ---
# Necesario para extracts que leen del Drive de Martín / FCST manual.
# El archivo JSON debe vivir en la ruta indicada — NO commitear el JSON.
GOOGLE_APPLICATION_CREDENTIALS=agente-comex/config/credentials.json

# --- 4. METADATA NO SENSIBLE ---
ANDRES_EMAIL=andres@unionx.cl

# --- 5. PATHS OPCIONALES (default si no se setean) ---
# MAESTRA_VENTAS_DB=data/db/maestra_ventas.db
# CONTRIBUCION_FILE=data/planillas/Analisis_Contribucion.xlsx

# API Seimex (flete forwarder) — usados por seimex_api.py / recordatorio_comex_lunes.py
SEIMEX_EMAIL=
SEIMEX_PASSWORD=
